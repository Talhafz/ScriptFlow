<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.ScriptFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/deep_charcoal</item>
        <item name="android:navigationBarColor">@color/deep_charcoal</item>
    </style>

    <!-- Splash Screen theme. -->
    <style name="Theme.ScriptFlow.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/deep_charcoal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="postSplashScreenTheme">@style/Theme.ScriptFlow</item>
    </style>
</resources>